{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostKey",
  "version": "0.1.0",
  "identifier": "com.anon0ne.ghostkey",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GhostKey",
        "width": 1200,
        "height": 760,
        "minWidth": 720,
        "minHeight": 420,
        "backgroundColor": "#23252E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "SSH client with the Kali Linux terminal look",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
